{
  "name": "streamer-ai",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, conversational film and series discovery app with guided provider integrations.",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12 <26",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @streamer-ai/server --filter @streamer-ai/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
