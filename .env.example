# Non-secret local runtime settings. Provider credentials are entered through the
# guided setup UI and stored by the local secret-store adapter, never in this file.
STREAMERAI_HOST=127.0.0.1
STREAMERAI_PORT=4400
STREAMERAI_DATA_DIR=./data
STREAMERAI_WEB_ORIGIN=http://localhost:5173
STREAMERAI_LOG_LEVEL=info

TMDB_BASE_URL=https://api.themoviedb.org
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

SYNC_PROVIDER=local
WEB_SEARCH_PROVIDER=disabled
